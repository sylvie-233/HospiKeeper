<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 与 FluentTheme 共享的强调色，保证日历 / 单选等原生控件同色 -->
  <Color x:Key="SystemAccentColor">#1677FF</Color>
  <Color x:Key="SystemAccentColorLight1">#4096FF</Color>
  <Color x:Key="SystemAccentColorLight2">#69B1FF</Color>
  <Color x:Key="SystemAccentColorLight3">#91CAFF</Color>
  <Color x:Key="SystemAccentColorDark1">#0958D9</Color>
  <Color x:Key="SystemAccentColorDark2">#003EB3</Color>
  <Color x:Key="SystemAccentColorDark3">#002C8C</Color>

  <!-- ============ Ant Design 色彩 Token ============ -->  <Color x:Key="AntPrimaryColor">#1677FF</Color>
  <Color x:Key="AntPrimaryHoverColor">#4096FF</Color>
  <Color x:Key="AntSuccessColor">#52C41A</Color>
  <Color x:Key="AntWarningColor">#FAAD14</Color>
  <Color x:Key="AntErrorColor">#FF4D4F</Color>
  <Color x:Key="AntPurpleColor">#722ED1</Color>
  <Color x:Key="AntCyanColor">#13C2C2</Color>
  <Color x:Key="AntOrangeColor">#FA8C16</Color>
  <Color x:Key="AntRedColor">#CF1322</Color>
  <Color x:Key="AntTextColor">#1F1F1F</Color>
  <Color x:Key="AntTextSecondaryColor">#595959</Color>
  <Color x:Key="AntTextTertiaryColor">#8C8C8C</Color>
  <Color x:Key="AntTextQuaternaryColor">#BFBFBF</Color>
  <Color x:Key="AntBorderColor">#D9D9D9</Color>
  <Color x:Key="AntSplitColor">#F0F0F0</Color>

  <SolidColorBrush x:Key="AntPrimaryBrush" Color="{StaticResource AntPrimaryColor}" />
  <SolidColorBrush x:Key="AntPrimaryHoverBrush" Color="{StaticResource AntPrimaryHoverColor}" />
  <SolidColorBrush x:Key="AntSuccessBrush" Color="{StaticResource AntSuccessColor}" />
  <SolidColorBrush x:Key="AntWarningBrush" Color="{StaticResource AntWarningColor}" />
  <SolidColorBrush x:Key="AntErrorBrush" Color="{StaticResource AntErrorColor}" />
  <SolidColorBrush x:Key="AntPurpleBrush" Color="{StaticResource AntPurpleColor}" />
  <SolidColorBrush x:Key="AntCyanBrush" Color="{StaticResource AntCyanColor}" />
  <SolidColorBrush x:Key="AntOrangeBrush" Color="{StaticResource AntOrangeColor}" />
  <SolidColorBrush x:Key="AntRedBrush" Color="{StaticResource AntRedColor}" />

  <SolidColorBrush x:Key="AntTextBrush" Color="{StaticResource AntTextColor}" />
  <SolidColorBrush x:Key="AntTextSecondaryBrush" Color="{StaticResource AntTextSecondaryColor}" />
  <SolidColorBrush x:Key="AntTextTertiaryBrush" Color="{StaticResource AntTextTertiaryColor}" />
  <SolidColorBrush x:Key="AntTextQuaternaryBrush" Color="{StaticResource AntTextQuaternaryColor}" />
  <SolidColorBrush x:Key="AntBorderBrush" Color="{StaticResource AntBorderColor}" />
  <SolidColorBrush x:Key="AntSplitBrush" Color="{StaticResource AntSplitColor}" />

  <SolidColorBrush x:Key="AntBgContainerBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AntBgLayoutBrush" Color="#F5F7FA" />
  <SolidColorBrush x:Key="AntBgPanelBrush" Color="#FAFAFA" />
  <SolidColorBrush x:Key="AntFillSecondaryBrush" Color="#F5F5F5" />

  <SolidColorBrush x:Key="AntPrimaryBgBrush" Color="#E6F4FF" />
  <SolidColorBrush x:Key="AntPrimaryBorderBrush" Color="#91CAFF" />
  <SolidColorBrush x:Key="AntSuccessBgBrush" Color="#F6FFED" />
  <SolidColorBrush x:Key="AntSuccessBorderBrush" Color="#B7EB8F" />
  <SolidColorBrush x:Key="AntWarningBgBrush" Color="#FFFBE6" />
  <SolidColorBrush x:Key="AntWarningSoftBgBrush" Color="#FFF7E6" />
  <SolidColorBrush x:Key="AntWarningBorderBrush" Color="#FFE58F" />
  <SolidColorBrush x:Key="AntErrorBgBrush" Color="#FFF1F0" />
  <SolidColorBrush x:Key="AntErrorBorderBrush" Color="#FFCCC7" />
  <SolidColorBrush x:Key="AntPurpleBgBrush" Color="#F9F0FF" />
  <SolidColorBrush x:Key="AntPurpleBorderBrush" Color="#D3ADF7" />
  <SolidColorBrush x:Key="AntCyanBgBrush" Color="#E6FFFB" />
  <SolidColorBrush x:Key="AntCyanBorderBrush" Color="#87E8DE" />

  <!-- ============ 字体与尺寸 ============ -->
  <FontFamily x:Key="AntFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, PingFang SC</FontFamily>
  <x:Double x:Key="AntFontSize">13</x:Double>
  <x:Double x:Key="AntFontSizeSmall">12</x:Double>
  <x:Double x:Key="AntFontSizeLarge">14</x:Double>
  <x:Double x:Key="AntControlHeight">32</x:Double>
  <x:Double x:Key="AntControlHeightSmall">24</x:Double>
  <x:Double x:Key="AntControlHeightLarge">40</x:Double>
  <CornerRadius x:Key="AntCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="AntCardCornerRadius">8</CornerRadius>
  <Thickness x:Key="AntCardPadding">16</Thickness>

  <!-- ============ 房态渐变 ============ -->
  <LinearGradientBrush x:Key="AntRoomFreeBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#73D13D" Offset="0" />
    <GradientStop Color="#52C41A" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AntRoomOccupiedBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#4096FF" Offset="0" />
    <GradientStop Color="#1677FF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AntRoomReservedBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#9254DE" Offset="0" />
    <GradientStop Color="#722ED1" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AntRoomCleaningBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#36CFC9" Offset="0" />
    <GradientStop Color="#13C2C2" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AntRoomRepairBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#FFC53D" Offset="0" />
    <GradientStop Color="#FAAD14" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AntRoomStoppedBrush" Color="#BFBFBF" />

</ResourceDictionary>
