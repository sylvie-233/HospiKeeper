@inject SiteSettingsState SettingsState

<footer class="footer">
    <div class="footer-cols">
        <div>
            <div class="footer-logo"><span class="mark">@_settings.BrandMark</span>@_settings.BrandName</div>
            <p>@_settings.FooterDescription</p>
        </div>
        <div>
            <h4>快捷导航</h4>
            <ul>
                <li><a href="/">首页</a></li>
                <li><a href="/rooms">客房预订</a></li>
                <li><a href="/mine">我的预订</a></li>
            </ul>
        </div>
        <div>
            <h4>入住信息</h4>
            <ul>
                <li>入住时间 @_settings.CheckInTime</li>
                <li>退房时间 @_settings.CheckOutTime</li>
                <li>@_settings.PaymentNote</li>
            </ul>
        </div>
        <div>
            <h4>联系我们</h4>
            <ul>
                <li>地址：@_settings.Address</li>
                <li>电话：@_settings.Hotline</li>
                <li>邮箱：@_settings.Email</li>
            </ul>
        </div>
    </div>
    <div class="footer-bottom">@_settings.FooterText</div>
</footer>

@code {
    private SiteSettings _settings = new();

    protected override async Task OnInitializedAsync()
        => _settings = await SettingsState.GetAsync();
}
