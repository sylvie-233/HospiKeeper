@inject SiteSettingsState SettingsState

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="/">
            <span class="brand-mark">@_settings.BrandMark</span>
            <span class="brand-name">@_settings.BrandName<span class="brand-sub">@_settings.BrandEnglishName</span></span>
        </a>

        <nav class="nav-pills" aria-label="主导航">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">首页</NavLink>
            <NavLink class="nav-link" href="/rooms">客房预订</NavLink>
            <NavLink class="nav-link" href="/mine">我的预订</NavLink>
        </nav>

        <div class="hotline">
            <span class="hotline-dot"></span>
            <span>前台热线</span>
            <b>@_settings.Hotline</b>
        </div>
    </div>
</header>

@code {
    private SiteSettings _settings = new();

    protected override async Task OnInitializedAsync()
        => _settings = await SettingsState.GetAsync();
}
