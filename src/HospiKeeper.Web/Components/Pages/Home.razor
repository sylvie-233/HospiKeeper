@page "/"
@inject IGuestBookingApi Api
@inject SiteSettingsState SettingsState
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>@_settings.BrandName · 在线预订</PageTitle>

<section class="hero">
    <div class="hero-inner">
        <div class="eyebrow">@_settings.LocationTagline</div>
        <h1>@_settings.HeroTitlePrefix<span class="accent">@_settings.HeroAccent</span>@_settings.HeroTitleSuffix</h1>
        <p>@_settings.HeroSubtitle</p>

        <div class="hero-stats">
            <div class="stat"><b>@RoomCount</b><span>间客房</span></div>
            <div class="stat"><b>@TypeCount</b><span>种房型</span></div>
            <div class="stat"><b>@_settings.WalkToLakeMinutes</b><span>分钟步行至湖边</span></div>
            <div class="stat"><b>@_settings.Rating.ToString("0.0")</b><span>住客评分</span></div>
        </div>
    </div>
</section>

<div class="search-wrap">
    <DateSearchBar CheckIn="_checkIn" CheckOut="_checkOut" TypeId="@null"
                   RoomTypes="_availability?.RoomTypes ?? []"
                   OnSearch="GoRoomsAsync" />
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="page-error">@_error</div>
}

<section class="section">
    <div class="sec-head">
        <div>
            <div class="section-eyebrow">FEATURED ROOMS</div>
            <div class="section-title">精选房型</div>
        </div>
        <a class="link-more" href="/rooms">查看全部房型 →</a>
    </div>

    @if (_loading)
    {
        <div class="room-grid">
            @for (var i = 0; i < 3; i++)
            {
                <div class="room-card skeleton"></div>
            }
        </div>
    }
    else if (_availability is not null)
    {
        <div class="room-grid">
            @foreach (var type in _availability.RoomTypes.Take(3))
            {
                <RoomTypeCard RoomType="type" Nights="@_availability.Nights" OnBook="BookTypeAsync" />
            }
        </div>
    }
</section>

@if (_settings.Features.Count > 0)
{
    <section class="section">
        <div class="sec-head">
            <div>
                <div class="section-eyebrow">WHY @_settings.BrandEnglishName</div>
                <div class="section-title">为什么选择 @_settings.BrandName</div>
            </div>
        </div>
        <div class="feature-grid">
            @foreach (var feature in _settings.Features)
            {
                <div class="feature">
                    <div class="ico">@feature.Icon</div>
                    <h4>@feature.Title</h4>
                    <p>@feature.Description</p>
                </div>
            }
        </div>
    </section>
}

@if (_settings.Notices.Count > 0)
{
    <section class="section">
        <div class="sec-head">
            <div>
                <div class="section-eyebrow">BEFORE YOU ARRIVE</div>
                <div class="section-title">入住须知</div>
            </div>
        </div>
        <div class="notice-grid">
            @foreach (var notice in _settings.Notices)
            {
                <div class="notice">
                    <h4>@notice.Title</h4>
                    <p>@notice.Line1</p>
                    @if (!string.IsNullOrWhiteSpace(notice.Line2))
                    {
                        <p>@notice.Line2</p>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    private DateTime _checkIn = DateTime.Today;
    private DateTime _checkOut = DateTime.Today.AddDays(1);
    private HotelSummaryDto? _summary;
    private GuestAvailabilityResult? _availability;
    private SiteSettings _settings = new();
    private bool _loading = true;
    private string? _error;

    private int RoomCount => _summary?.RoomCount ?? 14;
    private int TypeCount => _summary?.TypeCount ?? 3;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settingsTask = SettingsState.GetAsync();
            var summaryTask = Api.GetSummaryAsync();
            var availabilityTask = Api.GetAvailabilityAsync(_checkIn, _checkOut);
            await Task.WhenAll(settingsTask, summaryTask, availabilityTask);

            _settings = await settingsTask;
            _summary = await summaryTask;
            _availability = await availabilityTask;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _settings = await SettingsState.GetAsync();
            _error = "暂时无法获取房态，请稍后刷新或联系前台。";
            Toast.Error(_error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GoRoomsAsync(SearchCriteria criteria)
    {
        _checkIn = criteria.CheckIn;
        _checkOut = criteria.CheckOut;
        Navigation.NavigateTo(
            $"/rooms?checkIn={_checkIn:yyyy-MM-dd}&checkOut={_checkOut:yyyy-MM-dd}" +
            (criteria.TypeId is int typeId ? $"&typeId={typeId}" : string.Empty));
        await Task.CompletedTask;
    }

    private async Task BookTypeAsync(GuestRoomTypeDto type)
    {
        Navigation.NavigateTo(
            $"/rooms?checkIn={_checkIn:yyyy-MM-dd}&checkOut={_checkOut:yyyy-MM-dd}&typeId={type.TypeId}");
        await Task.CompletedTask;
    }
}
