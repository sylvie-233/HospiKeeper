@if (Status == ReservationStatus.Pending)
{
    <span class="status-tag tag-pending"><span class="dot"></span>待到店</span>
}
else if (Status == ReservationStatus.Converted)
{
    <span class="status-tag tag-converted"><span class="dot"></span>已转入住</span>
}
else
{
    <span class="status-tag tag-cancelled"><span class="dot"></span>已取消</span>
}

@code {
    [Parameter, EditorRequired] public ReservationStatus Status { get; set; }
}
