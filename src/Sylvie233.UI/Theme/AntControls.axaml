<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Sylvie233.UI.Controls"
                    xmlns:icons="using:Sylvie233.UI.Icons"
                    xmlns:conv="using:Avalonia.Data.Converters">

  <!-- ============================================================ -->
  <!-- AntButton                                                    -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntButton}" TargetType="controls:AntButton">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource AntBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AntTextBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AntCornerRadius}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="{DynamicResource AntControlHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource AntFontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource AntFontFamily}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AntPrimaryHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AntPrimaryBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.86" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="^:primary">
      <Setter Property="Background" Value="{DynamicResource AntPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntPrimaryBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="^:primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AntPrimaryHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntPrimaryHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="^:danger">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntErrorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AntErrorBrush}" />
    </Style>
    <Style Selector="^:danger:pointerover">
      <Setter Property="Background" Value="{DynamicResource AntErrorBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntErrorBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="^:text">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="^:text:pointerover">
      <Setter Property="Background" Value="{DynamicResource AntFillSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AntPrimaryBrush}" />
    </Style>

    <Style Selector="^:link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AntPrimaryBrush}" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="^:link:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AntPrimaryHoverBrush}" />
    </Style>

    <Style Selector="^:small">
      <Setter Property="Height" Value="{DynamicResource AntControlHeightSmall}" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="FontSize" Value="{DynamicResource AntFontSizeSmall}" />
    </Style>
    <Style Selector="^:large">
      <Setter Property="Height" Value="{DynamicResource AntControlHeightLarge}" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="FontSize" Value="{DynamicResource AntFontSizeLarge}" />
    </Style>
    <Style Selector="^:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AntPrimaryBrush}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntTag                                                       -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntTag}" TargetType="controls:AntTag">
    <Setter Property="Background" Value="#FAFAFA" />
    <Setter Property="BorderBrush" Value="{DynamicResource AntBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AntTextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="FontSize" Value="{DynamicResource AntFontSizeSmall}" />
    <Setter Property="FontFamily" Value="{DynamicResource AntFontFamily}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:success">
      <Setter Property="Foreground" Value="{DynamicResource AntSuccessBrush}" />
      <Setter Property="Background" Value="{DynamicResource AntSuccessBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntSuccessBorderBrush}" />
    </Style>
    <Style Selector="^:processing">
      <Setter Property="Foreground" Value="{DynamicResource AntPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource AntPrimaryBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntPrimaryBorderBrush}" />
    </Style>
    <Style Selector="^:warning">
      <Setter Property="Foreground" Value="{DynamicResource AntWarningBrush}" />
      <Setter Property="Background" Value="{DynamicResource AntWarningBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntWarningBorderBrush}" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="Foreground" Value="{DynamicResource AntErrorBrush}" />
      <Setter Property="Background" Value="{DynamicResource AntErrorBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntErrorBorderBrush}" />
    </Style>
    <Style Selector="^:purple">
      <Setter Property="Foreground" Value="{DynamicResource AntPurpleBrush}" />
      <Setter Property="Background" Value="{DynamicResource AntPurpleBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntPurpleBorderBrush}" />
    </Style>
    <Style Selector="^:cyan">
      <Setter Property="Foreground" Value="{DynamicResource AntCyanBrush}" />
      <Setter Property="Background" Value="{DynamicResource AntCyanBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AntCyanBorderBrush}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntCard                                                      -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntCard}" TargetType="controls:AntCard">
    <Setter Property="Background" Value="{DynamicResource AntBgContainerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AntSplitBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AntCardCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource AntCardPadding}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="0 1 3 0 #0A000000">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource AntSplitBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,12"
                    Margin="0,0,0,14"
                    IsVisible="{TemplateBinding Header, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
              <Grid ColumnDefinitions="*,Auto">
                <ContentPresenter Content="{TemplateBinding Header}"
                                  FontSize="{DynamicResource AntFontSizeLarge}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1"
                                  Content="{TemplateBinding Extra}"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntPageHeader                                                -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntPageHeader}" TargetType="controls:AntPageHeader">
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="4" Height="20" CornerRadius="2"
                    Background="{DynamicResource AntPrimaryBrush}" />
            <StackPanel Spacing="2">
              <TextBlock Text="{TemplateBinding Title}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AntTextBrush}" />
              <TextBlock Text="{TemplateBinding Subtitle}"
                         FontSize="{DynamicResource AntFontSizeSmall}"
                         Foreground="{DynamicResource AntTextTertiaryBrush}"
                         IsVisible="{TemplateBinding Subtitle, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
          <ContentPresenter Grid.Column="1"
                            Content="{TemplateBinding Extra}"
                            VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntSectionTitle                                              -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntSectionTitle}" TargetType="controls:AntSectionTitle">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Border Width="3" Height="13" CornerRadius="2"
                    Background="{DynamicResource AntPrimaryBrush}" />
            <TextBlock Text="{TemplateBinding Title}"
                       FontSize="{DynamicResource AntFontSizeLarge}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AntTextBrush}" />
          </StackPanel>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Extra}" VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntFormItem                                                  -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntFormItem}" TargetType="controls:AntFormItem">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="2"
                      IsVisible="{TemplateBinding Label, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{TemplateBinding Label}"
                       FontSize="{DynamicResource AntFontSizeSmall}"
                       Foreground="{DynamicResource AntTextSecondaryBrush}" />
            <TextBlock Text="*"
                       FontSize="{DynamicResource AntFontSizeSmall}"
                       Foreground="{DynamicResource AntErrorBrush}"
                       IsVisible="{TemplateBinding Required}" />
          </StackPanel>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch" />
          <TextBlock Text="{TemplateBinding ErrorText}"
                     FontSize="11"
                     Foreground="{DynamicResource AntErrorBrush}"
                     IsVisible="{TemplateBinding ErrorText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntModal                                                     -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntModal}" TargetType="controls:AntModal">
    <Setter Property="Background" Value="{DynamicResource AntBgContainerBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Width="{TemplateBinding ModalWidth}"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="0 12 36 0 #40000000"
                ClipToBounds="True">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource AntBgPanelBrush}"
                    BorderBrush="{DynamicResource AntSplitBrush}"
                    BorderThickness="0,0,0,1"
                    Height="52"
                    Padding="20,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{TemplateBinding Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AntTextBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="ant-modal-close"
                        Command="{TemplateBinding CloseCommand}"
                        VerticalAlignment="Center">
                  <PathIcon Data="{x:Static icons:AntIcons.Close}" Width="11" Height="11" />
                </Button>
              </Grid>
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="20"
                              HorizontalContentAlignment="Stretch" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntRoomCard                                                  -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntRoomCard}" TargetType="controls:AntRoomCard">
    <Setter Property="Background" Value="{DynamicResource AntRoomFreeBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="96" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="FontFamily" Value="{DynamicResource AntFontFamily}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                CornerRadius="8"
                Padding="12,10">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left"
                         Text="{TemplateBinding RoomNo}"
                         FontSize="18"
                         FontWeight="Bold"
                         Foreground="#FFFFFF" />
              <TextBlock DockPanel.Dock="Right"
                         Text="{TemplateBinding PriceText}"
                         FontSize="11"
                         Foreground="#E6FFFFFF"
                         VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1"
                       Text="{TemplateBinding TypeName}"
                       FontSize="11"
                       Foreground="#D9FFFFFF"
                       Margin="0,1,0,0" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
              <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,0" Height="18"
                      VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding StatusText}"
                           FontSize="10"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{TemplateBinding GuestText}"
                         FontSize="11"
                         Foreground="#E6FFFFFF"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{TemplateBinding GuestText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:free">
      <Setter Property="Background" Value="{DynamicResource AntRoomFreeBrush}" />
    </Style>
    <Style Selector="^:occupied">
      <Setter Property="Background" Value="{DynamicResource AntRoomOccupiedBrush}" />
    </Style>
    <Style Selector="^:reserved">
      <Setter Property="Background" Value="{DynamicResource AntRoomReservedBrush}" />
    </Style>
    <Style Selector="^:cleaning">
      <Setter Property="Background" Value="{DynamicResource AntRoomCleaningBrush}" />
    </Style>
    <Style Selector="^:repair">
      <Setter Property="Background" Value="{DynamicResource AntRoomRepairBrush}" />
    </Style>
    <Style Selector="^:stopped">
      <Setter Property="Background" Value="{DynamicResource AntRoomStoppedBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="0 6 16 0 #40000000" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntStatCard                                                  -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntStatCard}" TargetType="controls:AntStatCard">
    <Setter Property="Background" Value="{DynamicResource AntBgContainerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AntSplitBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AntCardCornerRadius}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="MinHeight" Value="92" />
    <Setter Property="FontFamily" Value="{DynamicResource AntFontFamily}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="0 1 3 0 #0A000000">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42"
                    CornerRadius="10"
                    Background="{TemplateBinding IconBackground}"
                    VerticalAlignment="Center">
              <PathIcon Data="{TemplateBinding Icon}"
                        Width="20" Height="20"
                        Foreground="{TemplateBinding IconForeground}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Title}"
                         FontSize="{DynamicResource AntFontSizeSmall}"
                         Foreground="{DynamicResource AntTextSecondaryBrush}" />
              <TextBlock Text="{TemplateBinding Value}"
                         FontSize="22"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AntTextBrush}"
                         FontFamily="{DynamicResource AntFontFamily}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{TemplateBinding SubText}"
                           FontSize="11"
                           Foreground="{DynamicResource AntTextTertiaryBrush}"
                           IsVisible="{TemplateBinding SubText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{TemplateBinding TrendText}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{TemplateBinding TrendBrush}"
                           IsVisible="{TemplateBinding TrendText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntEmpty                                                     -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntEmpty}" TargetType="controls:AntEmpty">
    <Setter Property="FontFamily" Value="{DynamicResource AntFontFamily}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" Margin="20">
          <Border Width="56" Height="56" CornerRadius="28"
                  Background="{DynamicResource AntFillSecondaryBrush}"
                  HorizontalAlignment="Center">
            <PathIcon Data="{TemplateBinding Icon}"
                      Width="26" Height="26"
                      Foreground="{DynamicResource AntTextQuaternaryBrush}" />
          </Border>
          <TextBlock Text="{TemplateBinding Title}"
                     FontSize="{DynamicResource AntFontSize}"
                     Foreground="{DynamicResource AntTextSecondaryBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{TemplateBinding Description}"
                     FontSize="{DynamicResource AntFontSizeSmall}"
                     Foreground="{DynamicResource AntTextTertiaryBrush}"
                     HorizontalAlignment="Center"
                     IsVisible="{TemplateBinding Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntToast                                                     -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntToast}" TargetType="controls:AntToast">
    <Setter Property="Background" Value="{DynamicResource AntBgContainerBrush}" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="MaxWidth" Value="460" />
    <Setter Property="FontFamily" Value="{DynamicResource AntFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource AntFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="8"
                Padding="{TemplateBinding Padding}"
                BoxShadow="0 6 20 0 #26000000">
          <Grid ColumnDefinitions="Auto,*">
            <Border Name="PART_Icon"
                    Width="22" Height="22"
                    CornerRadius="11"
                    Background="{DynamicResource AntSuccessBrush}"
                    VerticalAlignment="Top"
                    Margin="0,1,0,0">
              <PathIcon Data="{TemplateBinding Icon}" Width="12" Height="12" Foreground="#FFFFFF" />
            </Border>
            <ContentPresenter Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="9,0,0,0"
                              VerticalContentAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:error /template/ Border#PART_Icon">
      <Setter Property="Background" Value="{DynamicResource AntErrorBrush}" />
    </Style>
    <Style Selector="^:warning /template/ Border#PART_Icon">
      <Setter Property="Background" Value="{DynamicResource AntWarningBrush}" />
    </Style>
    <Style Selector="^:info /template/ Border#PART_Icon">
      <Setter Property="Background" Value="{DynamicResource AntPrimaryBrush}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================ -->
  <!-- AntTable                                                     -->
  <!-- ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:AntTable}" TargetType="controls:AntTable">
    <Setter Property="Background" Value="{DynamicResource AntBgContainerBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AntFontFamily}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border Background="{DynamicResource AntBgPanelBrush}"
                    BorderBrush="{DynamicResource AntSplitBrush}"
                    BorderThickness="0,0,0,1"
                    Height="40">
              <Grid Name="PART_HeaderGrid" />
            </Border>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <ItemsControl Name="PART_Rows" />
                <TextBlock Name="PART_Empty"
                           Classes="ant-table-empty"
                           Text="{TemplateBinding EmptyText}" />
              </StackPanel>
            </ScrollViewer>
            <Border Name="PART_Pagination"
                    Grid.Row="2"
                    Classes="ant-pagination"
                    IsVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
