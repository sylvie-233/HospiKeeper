<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:HospiKeeper.Desktop.ViewModels.Dialogs"
             xmlns:controls="using:Sylvie233.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="HospiKeeper.Desktop.Views.Dialogs.CheckoutDialogView"
             x:DataType="dialogs:CheckoutDialogViewModel">

  <StackPanel Spacing="12">

    <!-- 在住快照 -->
    <Border Classes="ticket-head">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Classes="ticket-no" Text="{Binding GuestName}" />
          <TextBlock Classes="ticket-sub" Text="{Binding CheckInNo, StringFormat='入住单 {0}'}" />
          <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
            <TextBlock Classes="ticket-sub" Text="{Binding CheckInText, StringFormat='入住 {0}'}" />
            <TextBlock Classes="ticket-sub" Text="{Binding PlanOutText, StringFormat='预计退房 {0}'}" />
            <TextBlock Classes="ticket-sub" Text="{Binding PriceText, StringFormat='单价 {0}'}" />
            <TextBlock Classes="ticket-sub" Text="{Binding DepositText, StringFormat='押金 {0}'}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
          <TextBlock Classes="ticket-room-no" Text="{Binding RoomNo}" HorizontalAlignment="Right" />
          <TextBlock Classes="ticket-room-type" Text="{Binding RoomTypeName}" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 追加消费明细 -->
    <StackPanel Spacing="6">
      <TextBlock Classes="ticket-section" Text="追加消费明细" />
      <ItemsControl ItemsSource="{Binding Extras}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dialogs:ExtraLineViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Text="{Binding Item}" FontSize="12" />
              <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontSize="12" Classes="text-money" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="无追加消费" FontSize="12" Foreground="{DynamicResource AntTextTertiaryBrush}"
                 IsVisible="{Binding !HasExtras}" />
      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
        <TextBlock Text="小计" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="{Binding ExtraTotalText}" FontSize="12" Classes="text-money" />
      </Grid>
    </StackPanel>

    <Border Classes="ant-divider" Margin="0" />

    <!-- 结算录入 -->
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
      <controls:AntFormItem Label="实际退房时间" Required="True" ErrorText="{Binding ActualOutError}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Text="{Binding ActualOutText}" PlaceholderText="yyyy-MM-dd HH:mm" />
          <controls:AntButton Grid.Column="1" Variant="Link" Content="现在"
                              Command="{Binding SetNowCommand}" />
        </Grid>
      </controls:AntFormItem>
      <controls:AntFormItem Grid.Column="1" Label="损坏扣费（元）" ErrorText="{Binding DamageError}">
        <TextBox Text="{Binding DamageText}" PlaceholderText="0.00" />
      </controls:AntFormItem>
      <controls:AntFormItem Grid.Column="2" Label="计费方式">
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="dialogs:BillingModeOption">
              <TextBlock Text="{Binding Text}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </controls:AntFormItem>
    </Grid>

    <controls:AntFormItem Label="备注（损坏说明等）">
      <TextBox Text="{Binding Note}" Height="54" AcceptsReturn="True" TextWrapping="Wrap"
               PlaceholderText="选填" VerticalContentAlignment="Top" Padding="9,6" />
    </controls:AntFormItem>

    <!-- 实时试算 -->
    <Border Classes="ticket-grid">
      <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="1">
          <TextBlock Classes="ticket-label" Text="房费" />
          <TextBlock Classes="ticket-value" FontWeight="SemiBold" Text="{Binding RoomFeeText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock Classes="ticket-label" Text="追加消费" />
          <TextBlock Classes="ticket-value" FontWeight="SemiBold" Text="{Binding ExtraTotalText}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="1">
          <TextBlock Classes="ticket-label" Text="已收押金" />
          <TextBlock Classes="ticket-value" FontWeight="SemiBold" Text="{Binding DepositPreviewText}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Spacing="1">
          <TextBlock Classes="ticket-label" Text="应收合计" />
          <TextBlock Classes="ticket-value text-money" FontSize="16" FontWeight="Bold" Text="{Binding TotalText}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding FeeNote}" FontSize="11"
                   Foreground="{DynamicResource AntTextTertiaryBrush}" Margin="0,8,0,0" />
      </Grid>
    </Border>

    <Border Classes="ticket-result"
            Classes.refund="{Binding NeedsRefund}"
            Classes.even="{Binding IsEven}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="ticket-label" Text="结算差额（应收 − 押金）" />
          <TextBlock Text="{Binding ResultText}"
                     FontSize="19" FontWeight="Bold"
                     Classes.text-danger="{Binding NeedsPayment}"
                     Classes.text-success="{Binding NeedsRefund}"
                     Classes.text-primary="{Binding IsEven}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="20" FontWeight="Bold"
                   Classes="text-money" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Classes="ant-alert-error"
            IsVisible="{Binding SubmitError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding SubmitError}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource AntErrorBrush}" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <controls:AntButton Content="取消" Command="{Binding Host.CloseCommand}" />
      <controls:AntButton Variant="Primary" Content="确认结算" Command="{Binding SubmitCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
