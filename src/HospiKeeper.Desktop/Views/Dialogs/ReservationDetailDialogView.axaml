<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:HospiKeeper.Desktop.ViewModels.Dialogs"
             xmlns:controls="using:HospiKeeper.UI.Controls"
             x:Class="HospiKeeper.Desktop.Views.Dialogs.ReservationDetailDialogView"
             x:DataType="dialogs:ReservationDetailDialogViewModel">

  <StackPanel Spacing="12">
    <Border Classes="ticket-head">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Classes="ticket-no" Text="{Binding ResNo}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
            <controls:AntTag Variant="{Binding StatusVariant}" Content="{Binding StatusText}" />
            <TextBlock Classes="ticket-sub" Text="{Binding GuestName}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
          <TextBlock Classes="ticket-room-no" Text="{Binding RoomText}" HorizontalAlignment="Right" FontSize="17" />
          <TextBlock Classes="ticket-room-type" Text="{Binding ArriveText, StringFormat='到店 {0}'}"
                     HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="ticket-grid">
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
        <StackPanel Spacing="1">
          <TextBlock Classes="ticket-label" Text="客人" />
          <TextBlock Classes="ticket-value" FontWeight="SemiBold" Text="{Binding GuestName}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock Classes="ticket-label" Text="联系电话" />
          <TextBlock Classes="ticket-value" Text="{Binding GuestPhone}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="1">
          <TextBlock Classes="ticket-label" Text="到店时间" />
          <TextBlock Classes="ticket-value" Text="{Binding ArriveText}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1">
          <TextBlock Classes="ticket-label" Text="创建时间" />
          <TextBlock Classes="ticket-value" Text="{Binding CreatedText}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="1">
          <TextBlock Classes="ticket-label" Text="经办人" />
          <TextBlock Classes="ticket-value" Text="{Binding OperatorName}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="1">
          <TextBlock Classes="ticket-label" Text="关联入住单" />
          <TextBlock Classes="ticket-value" Text="{Binding CheckInText}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="ticket-note">
      <StackPanel Spacing="2">
        <TextBlock Classes="ticket-label" Text="备注" />
        <TextBlock Text="{Binding NoteText}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <controls:AntButton HorizontalAlignment="Right" Content="关闭" Command="{Binding CloseCommand}" />
  </StackPanel>
</UserControl>
