<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:HospiKeeper.Desktop.ViewModels.Dialogs"
             xmlns:controls="using:Sylvie233.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="HospiKeeper.Desktop.Views.Dialogs.ChangePasswordDialogView"
             x:DataType="dialogs:ChangePasswordDialogViewModel">

  <StackPanel Spacing="12">
    <Border Classes="ant-alert-error"
            IsVisible="{Binding SubmitError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding SubmitError}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource AntErrorBrush}" />
    </Border>

    <controls:AntFormItem Label="原密码" Required="True" ErrorText="{Binding OldPasswordError}">
      <TextBox Text="{Binding OldPassword}" PasswordChar="●" PlaceholderText="请输入当前密码" />
    </controls:AntFormItem>

    <controls:AntFormItem Label="新密码" Required="True" ErrorText="{Binding NewPasswordError}">
      <TextBox Text="{Binding NewPassword}" PasswordChar="●" PlaceholderText="至少 6 位" />
    </controls:AntFormItem>

    <controls:AntFormItem Label="确认新密码" Required="True" ErrorText="{Binding ConfirmPasswordError}">
      <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" PlaceholderText="再次输入新密码" />
    </controls:AntFormItem>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <controls:AntButton Content="取消" Command="{Binding Host.CloseCommand}" />
      <controls:AntButton Variant="Primary" Content="确认修改" Command="{Binding SubmitCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
