<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:HospiKeeper.Desktop.ViewModels.Pages"
             xmlns:controls="using:HospiKeeper.UI.Controls"
             xmlns:icons="using:HospiKeeper.UI.Icons"
             x:Class="HospiKeeper.Desktop.Views.Pages.ReservationsView"
             x:DataType="pages:ReservationsPageViewModel">

  <Grid Margin="16" RowDefinitions="Auto,Auto,*">

    <controls:AntPageHeader Title="预定管理" Subtitle="待到店、转入住与取消预定">
      <controls:AntPageHeader.Extra>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:AntButton Command="{Binding RefreshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static icons:AntIcons.Refresh}" Width="13" Height="13" />
              <TextBlock Text="刷新" />
            </StackPanel>
          </controls:AntButton>
          <controls:AntButton Variant="Primary" Command="{Binding AddCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static icons:AntIcons.Plus}" Width="12" Height="12" />
              <TextBlock Text="新增预定" />
            </StackPanel>
          </controls:AntButton>
        </StackPanel>
      </controls:AntPageHeader.Extra>
    </controls:AntPageHeader>

    <controls:AntCard Grid.Row="1" Padding="14,12" Margin="0,0,0,12">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <ComboBox Width="140" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="pages:ReservationStatusOption">
              <TextBlock Text="{Binding Text}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Grid.Column="1" Width="190" Margin="8,0,0,0"
                 Text="{Binding Keyword}" PlaceholderText="姓名 / 手机号 / 房号" />
        <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12"
                   Foreground="{DynamicResource AntTextTertiaryBrush}" VerticalAlignment="Center" />
      </Grid>
    </controls:AntCard>

    <controls:AntCard Grid.Row="2" Padding="0" ClipToBounds="True">
      <controls:AntTable ItemsSource="{Binding Rows}" EmptyText="暂无预定记录">
        <controls:AntTable.Columns>
          <controls:AntTableColumn Header="预定单号" Binding="ResNo" Width="1.5*" CellClasses="text-strong" />
          <controls:AntTableColumn Header="客人" Binding="GuestName" Width="0.9*" />
          <controls:AntTableColumn Header="电话" Binding="GuestPhone" Width="1.1*" />
          <controls:AntTableColumn Header="房间" Binding="RoomText" Width="1.1*" />
          <controls:AntTableColumn Header="到店时间" Binding="ArriveText" Width="1*" />
          <controls:AntTableColumn Header="状态" Width="86">
            <controls:AntTableColumn.CellTemplate>
              <DataTemplate x:DataType="pages:ReservationRowViewModel">
                <controls:AntTag Variant="{Binding StatusVariant}" Content="{Binding StatusText}" />
              </DataTemplate>
            </controls:AntTableColumn.CellTemplate>
          </controls:AntTableColumn>
          <controls:AntTableColumn Header="入住单号" Binding="CheckInText" Width="1.3*" CellClasses="text-secondary" />
          <controls:AntTableColumn Header="经办人" Binding="OperatorName" Width="1.1*" />
          <controls:AntTableColumn Header="操作" Width="190">
            <controls:AntTableColumn.CellTemplate>
              <DataTemplate x:DataType="pages:ReservationRowViewModel">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <controls:AntButton Variant="Link" Size="Small" Content="转入住"
                                      IsVisible="{Binding IsPending}" Command="{Binding ConvertCommand}" />
                  <controls:AntButton Variant="Link" Size="Small" Content="详情"
                                      Command="{Binding DetailCommand}" />
                  <controls:AntButton Variant="Link" Size="Small" Content="取消"
                                      IsVisible="{Binding IsPending}"
                                      Foreground="{DynamicResource AntErrorBrush}"
                                      Command="{Binding CancelCommand}" />
                </StackPanel>
              </DataTemplate>
            </controls:AntTableColumn.CellTemplate>
          </controls:AntTableColumn>
        </controls:AntTable.Columns>
      </controls:AntTable>
    </controls:AntCard>
  </Grid>
</UserControl>
