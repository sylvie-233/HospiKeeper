<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:HospiKeeper.Desktop.ViewModels.Pages"
             xmlns:controls="using:Sylvie233.UI.Controls"
             xmlns:icons="using:Sylvie233.UI.Icons"
             x:Class="HospiKeeper.Desktop.Views.Pages.LogsView"
             x:DataType="pages:LogsPageViewModel">

  <Grid Margin="16" RowDefinitions="Auto,Auto,*">

    <controls:AntPageHeader Title="操作日志" Subtitle="开房、退房、预定、改价等操作留痕；前台仅可查看本人记录">
      <controls:AntPageHeader.Extra>
        <controls:AntButton Command="{Binding QueryCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{x:Static icons:AntIcons.Refresh}" Width="13" Height="13" />
            <TextBlock Text="刷新" />
          </StackPanel>
        </controls:AntButton>
      </controls:AntPageHeader.Extra>
    </controls:AntPageHeader>

    <controls:AntCard Grid.Row="1" Padding="14,12" Margin="0,0,0,12">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
        <ComboBox Width="150" ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction}" />
        <TextBox Grid.Column="1" Width="210" Text="{Binding Keyword}"
                 PlaceholderText="操作人 / 房号 / 明细" />
        <controls:AntButton Grid.Column="2" Variant="Primary" Content="查询"
                            Command="{Binding QueryCommand}" />
        <controls:AntButton Grid.Column="3" Content="重置" HorizontalAlignment="Left"
                            Command="{Binding ResetCommand}" />
        <TextBlock Grid.Column="4" Text="{Binding CountText}" FontSize="12"
                   Foreground="{DynamicResource AntTextTertiaryBrush}" VerticalAlignment="Center" />
      </Grid>
    </controls:AntCard>

    <controls:AntCard Grid.Row="2" Padding="0" ClipToBounds="True">
      <controls:AntTable ItemsSource="{Binding Rows}" EmptyText="暂无操作日志">
        <controls:AntTable.Columns>
          <controls:AntTableColumn Header="时间" Binding="TimeText" Width="1.3*" CellClasses="text-secondary" />
          <controls:AntTableColumn Header="操作人" Binding="UserName" Width="1.2*" />
          <controls:AntTableColumn Header="类型" Binding="Action" Width="0.8*" />
          <controls:AntTableColumn Header="对象" Binding="Target" Width="1.3*" />
          <controls:AntTableColumn Header="明细" Binding="Detail" Width="2.6*" />
          <controls:AntTableColumn Header="关联单号" Binding="BizNo" Width="1.3*" CellClasses="text-secondary" />
        </controls:AntTable.Columns>
      </controls:AntTable>
    </controls:AntCard>
  </Grid>
</UserControl>
