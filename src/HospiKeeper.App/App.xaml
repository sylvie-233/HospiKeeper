<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HospiKeeper.App"
             xmlns:conv="clr-namespace:HospiKeeper.App.Converters"
             x:Class="HospiKeeper.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
        <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
      <conv:InverseBoolConverter x:Key="InverseBool" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
