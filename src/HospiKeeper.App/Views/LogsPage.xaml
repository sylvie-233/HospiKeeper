<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:HospiKeeper.App.Controls"
             xmlns:vm="clr-namespace:HospiKeeper.App.ViewModels"
             x:Class="HospiKeeper.App.Views.LogsPage"
             x:DataType="vm:LogsViewModel"
             BackgroundColor="{StaticResource AppBg}"
             Shell.NavBarIsVisible="False">

  <Grid RowDefinitions="Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,18,16,8" ColumnSpacing="8">
      <Button Text="‹ 返回" Command="{Binding BackCommand}" Style="{StaticResource LinkButton}"
              FontSize="14" VerticalOptions="Center" />
      <VerticalStackLayout Grid.Column="1" Spacing="1">
        <Label Text="操作日志" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
        <Label Text="{Binding SummaryText}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
      </VerticalStackLayout>
      <Button Grid.Column="2" Text="刷新" Command="{Binding RefreshCommand}"
              Style="{StaticResource LinkButton}" VerticalOptions="Center" />
    </Grid>

    <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                Padding="16,0,16,10">
      <HorizontalStackLayout BindableLayout.ItemsSource="{Binding FilterChips}" Spacing="7">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="vm:FilterChipViewModel">
            <Border BackgroundColor="{Binding BackgroundColor}" Stroke="{Binding BorderColor}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 999" Padding="13,6">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Command}" />
              </Border.GestureRecognizers>
              <Label Text="{Binding Text}" TextColor="{Binding TextColor}" FontSize="12" />
            </Border>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </HorizontalStackLayout>
    </ScrollView>

        <ScrollView Grid.Row="2">
      <VerticalStackLayout Padding="16,0,16,24" Spacing="9">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Logs}" Spacing="9">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="vm:LogRowViewModel">
            <Border Style="{StaticResource Card}" Padding="12,10">
              <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                  <Border BackgroundColor="#F3F4F6" StrokeThickness="0"
                          StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                    <Label Text="{Binding Action}" TextColor="{Binding ActionColor}" FontSize="10"
                           FontAttributes="Bold" />
                  </Border>
                  <Label Grid.Column="1" Text="{Binding Target}" FontSize="12" FontAttributes="Bold"
                         VerticalOptions="Center" LineBreakMode="TailTruncation" />
                  <Label Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource Caption}"
                         VerticalOptions="Center" />
                </Grid>
                <Label Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11"
                       LineBreakMode="WordWrap" />
                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="{Binding UserName}" Style="{StaticResource Caption}" />
                  <Label Grid.Column="1" Text="{Binding BizNo}" Style="{StaticResource Caption}" />
                </Grid>
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        <VerticalStackLayout Padding="20,40" Spacing="6" HorizontalOptions="Center" IsVisible="{Binding IsEmpty}">
            <Label Text="☷" FontSize="30" HorizontalTextAlignment="Center" />
            <Label Text="暂无操作日志" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>

    <controls:ToastHost ZIndex="20" Grid.RowSpan="3" Margin="20,0,20,24" />
  </Grid>
</ContentPage>
