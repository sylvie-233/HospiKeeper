<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <Style x:Key="PageTitle" TargetType="Label">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
  </Style>

  <Style x:Key="PageSubtitle" TargetType="Label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="Label">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
  </Style>

  <Style x:Key="Muted" TargetType="Label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
  </Style>

  <Style x:Key="Caption" TargetType="Label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
  </Style>

  <Style x:Key="Money" TargetType="Label">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="TextColor" Value="{StaticResource Orange}" />
  </Style>

  <Style x:Key="KpiValue" TargetType="Label">
    <Setter Property="FontSize" Value="23" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Shadow">
      <Setter.Value>
        <Shadow Brush="#000000" Opacity="0.06" Radius="10" Offset="0,3" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Sheet" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="StrokeShape" Value="RoundRectangle 24,24,0,0" />
    <Setter Property="Padding" Value="18,16,18,24" />
  </Style>

  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="BackgroundColor" Value="#FFFFFF" />
    <Setter Property="TextColor" Value="{StaticResource Primary}" />
    <Setter Property="BorderColor" Value="#DBEAFE" />
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HeightRequest" Value="38" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button">
    <Setter Property="BackgroundColor" Value="{StaticResource Error}" />
    <Setter Property="TextColor" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HeightRequest" Value="38" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{StaticResource Primary}" />
    <Setter Property="BorderWidth" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HeightRequest" Value="30" />
    <Setter Property="Padding" Value="4,0" />
  </Style>

  <Style x:Key="Input" TargetType="Entry">
    <Setter Property="BackgroundColor" Value="#FFFFFF" />
    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HeightRequest" Value="44" />
  </Style>

  <Style x:Key="SearchEntry" TargetType="Entry">
    <Setter Property="BackgroundColor" Value="#FFFFFF" />
    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HeightRequest" Value="40" />
  </Style>

  <Style x:Key="Divider" TargetType="BoxView">
    <Setter Property="HeightRequest" Value="1" />
    <Setter Property="Color" Value="{StaticResource Split}" />
  </Style>

</ResourceDictionary>
