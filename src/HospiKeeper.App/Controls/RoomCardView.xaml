<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HospiKeeper.App.Controls.RoomCardView">
  <Border BackgroundColor="{Binding BackgroundColor}" StrokeThickness="0"
          StrokeShape="RoundRectangle 13" Padding="11,10" HeightRequest="104">
    <Border.GestureRecognizers>
      <TapGestureRecognizer Command="{Binding OpenCommand}" />
    </Border.GestureRecognizers>
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto">
        <Label Text="{Binding RoomNo}" TextColor="#FFFFFF" FontSize="18" FontAttributes="Bold" />
        <Label Grid.Column="1" Text="{Binding StatusText}" TextColor="#E5E7EB" FontSize="10"
               VerticalOptions="Center" />
      </Grid>
      <Label Grid.Row="1" Text="{Binding TypeName}" TextColor="#E5E7EB" FontSize="10" />
      <Label Grid.Row="2" Text="{Binding GuestText}" TextColor="#F9FAFB" FontSize="10"
             LineBreakMode="TailTruncation" VerticalOptions="End" />
      <Label Grid.Row="3" Text="{Binding PriceText}" TextColor="#E5E7EB" FontSize="10" />
    </Grid>
  </Border>
</ContentView>
